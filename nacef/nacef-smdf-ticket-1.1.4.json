{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "NACEF Ticket payload",
  "description": "Représente les données d'une transaction de vente",
  "properties": {
      "data_type": {
          "title": "Data type",
          "type": "string",
          "const": "ncf.cashier.operation",
          "description": "Type de données pour cette opération."
      },
      "version": {
          "title": "Version",
          "type": "string",
          "const": "1.1.4",
          "description": "Version du schéma JSON"
      },
      "transaction": {
          "title": "Transaction",
          "type": "object",
          "properties": {
              "id": {
                  "title": "Transaction identifier",
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 48,
                  "examples": [
                      "YYXXXXXX",
                      "YYXXXXXXXXX"
                  ],
                  "description": "Identifiant unique pour la transaction."
              },
              "timestamp": {
                  "title": "Timestamp",
                  "type": "string",
                  "format": "date-time",
                  "description": "Date et heure de la transaction au format ISO 8601"
              },
              "operation": {
                  "title": "Operation",
                  "type": "object",
                  "properties": {
                      "op_type": {
                          "title": "Operation type",
                          "type": "string",
                          "enum": [
                              "TICKET",
                              "PROFORMA",
                              "REFUND",
                              "DUPLICATE"
                          ],
                          "description": "Type d'opération réalisée:\n - TICKET: Ticket normal\n- PROFORMA: Ticket Proforma\n- REFUND: Remboursement\n- DUPLICATE: Copie de ticket"
                      },
                      "context": {
                          "title": "Context",
                          "type": "string",
                          "enum": [
                              "SALE",
                              "TRAINING"
                          ],
                          "description": "Contexte de l'opération:\n- SALE: Vente (en production)\n- TRAINING: Formation (hors production)"
                      }
                  },
                  "additionalProperties": true,
                  "description": "Type d'opération effectuée.",
                  "if": {
                      "properties": {
                          "op_type": {
                              "title": "Operation type",
                              "type": "string",
                              "const": "DUPLICATE"
                          }
                      }
                  },
                  "then": {
                      "properties": {
                          "duplicated_transaction_identifier": {
                              "title": "Transaction identifier",
                              "type": "string",
                              "minLength": 8,
                              "maxLength": 48,
                              "examples": [
                                  "YYXXXXXX",
                                  "YYXXXXXXXXX"
                              ],
                              "description": "Identifiant unique pour la transaction."
                          }
                      },
                      "required": [
                          "duplicated_transaction_identifier"
                      ]
                  },
                  "required": [
                      "op_type",
                      "context"
                  ]
              },
              "originator": {
                  "title": "Transaction originator",
                  "type": "object",
                  "properties": {
                      "agent_identifier": {
                          "title": "Agent identifier",
                          "type": "string",
                          "maxLength": 32,
                          "minLength": 3,
                          "description": "Identifiant de l'agent qui a réalisé la transaction."
                      },
                      "imdf": {
                          "title": "IMDF",
                          "type": "string",
                          "minLength": 14,
                          "maxLength": 16,
                          "description": "Identifiant du module de données fiscales (MDF)"
                      },
                      "cash_register_serialnumber": {
                          "title": "Cash register serial number",
                          "type": "string",
                          "minLength": 8,
                          "maxLength": 32,
                          "description": "Numéro de série de la caisse enregistreuse utilisée"
                      },
                      "cash_register_software": {
                          "title": "Cash register software",
                          "type": "string",
                          "minLength": 8,
                          "maxLength": 32,
                          "description": "Nom du logiciel de caisse utilisé pour traiter la transaction"
                      },
                      "accreditation_reference": {
                          "title": "Accreditation reference",
                          "type": "string",
                          "minLength": 8,
                          "maxLength": 32,
                          "description": "Référence du certificat d'homologation de la caisse enregistreuse."
                      }
                  },
                  "additionalProperties": false,
                  "description": "Informations sur l'entité émettrice de la transaction",
                  "required": [
                      "agent_identifier",
                      "imdf",
                      "cash_register_serialnumber",
                      "cash_register_software",
                      "accreditation_reference"
                  ]
              }
          },
          "additionalProperties": false,
          "description": "Informations sur la transaction.",
          "required": [
              "id",
              "timestamp",
              "operation",
              "originator"
          ]
      },
      "merchant_identity": {
          "title": "Merchant identity",
          "type": "object",
          "properties": {
              "id": {
                  "title": "Identifier code",
                  "type": "string",
                  "maxLength": 8,
                  "pattern": "^\\d{7}[A-Z]$",
                  "minLength": 8,
                  "description": "Matricule fiscal du commerçant.",
                  "format": "regex"
              },
              "id_type": {
                  "title": "Identifier type",
                  "type": "string",
                  "const": "MF",
                  "description": "Type identifiant du commerçant (Matricule fiscal). Constante : MF."
              },
              "taxpayer_establishment": {
                  "title": "Taxpayer establishment",
                  "type": "object",
                  "properties": {
                      "commercial_name": {
                          "title": "Commercial name",
                          "type": "string",
                          "description": "Nom commercial de l'établissement.",
                          "maxLength": 64
                      },
                      "reference": {
                          "title": "Reference",
                          "type": "string",
                          "description": "Numéro établissement tel qu'il a été attribué par le bureau de contrôle des impôts (XXX):\n- 000 pour établissement principal\n- 00X pour établissement secondaire numéro 00X.",
                          "pattern": "^\\d{3}$",
                          "examples": [
                              "000",
                              "001"
                          ]
                      },
                      "address": {
                          "title": "Street address",
                          "type": "string",
                          "maxLength": 128,
                          "minLength": 8,
                          "description": "Adresse postale de l'établissement."
                      },
                      "city": {
                          "title": "City",
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 32,
                          "description": "Ville de l'établissement."
                      }
                  },
                  "additionalProperties": false,
                  "description": "Informations sur l'établissement fiscal du commerçant.",
                  "required": [
                      "commercial_name",
                      "reference",
                      "address",
                      "city"
                  ]
              }
          },
          "additionalProperties": true,
          "description": "Informations sur l'identité du commerçant.",
          "required": [
              "id",
              "id_type",
              "taxpayer_establishment"
          ]
      },
      "customer_identity": {
          "title": "Customer identity",
          "type": "object",
          "properties": {
              "fiscal_advantages": {
                  "title": "Fiscal advantages",
                  "type": "string",
                  "description": "Référence de l'attestation d'achat en suspension de taxes, si l'opération d'achat est soumise à un avantage fiscal.",
                  "minLength": 3,
                  "maxLength": 48
              },
              "id_type": {
                  "title": "Identifier type",
                  "type": "string",
                  "enum": [
                      "PP",
                      "NP"
                  ],
                  "description": "Type d'identifiant du client:\n- NP: Personne physique sans document d'identité,\n- PP: Personne identifiée par un Matricule fiscal.\n"
              },
              "id": {
                  "title": "Identifier code",
                  "type": "string"
              }
          },
          "additionalProperties": false,
          "description": "Informations sur le client.",
          "allOf": [
              {
                  "type": "object",
                  "if": {
                      "properties": {
                          "id_type": {
                              "title": "Identifier type",
                              "type": "string",
                              "const": "PP"
                          }
                      }
                  },
                  "then": {
                      "properties": {
                          "id": {
                              "title": "Identifier code",
                              "type": "string",
                              "pattern": "^\\d{7}[A-Z]$",
                              "minLength": 8,
                              "maxLength": 8,
                              "format": "regex"
                          }
                      },
                      "required": [
                          "id"
                      ]
                  },
                  "description": "Matricule fiscal .\n"

              }
          ],
          "required": [
              "id_type"
          ]
      },
      "sale_details": {
          "type": "array",
          "title": "Sale details",
          "items": {
              "title": "Sale item",
              "type": "object",
              "properties": {
                  "product": {
                      "title": "Product",
                      "type": "object",
                      "properties": {
                          "family_code": {
                              "title": "Family code",
                              "type": "string",
                              "maxLength": 8,
                              "minLength": 2,
                              "description": "Code famille produit telle qu'il est indiqué dans le cahier des charges."
                          },
                          "name": {
                              "title": "Name",
                              "type": "string",
                              "maxLength": 64,
                              "minLength": 3,
                              "description": "Désignation du produit."
                          },
                          "price_pre_tax": {
                              "title": "Price tax excluded",
                              "type": "integer",
                              "minimum": 1,
                              "description": "Prix unitaire Hors Taxes. En millimes, sans séparateurs et sans point décimal."
                          }
                      },
                      "additionalProperties": false,
                      "required": [
                          "family_code",
                          "name",
                          "price_pre_tax"
                      ]
                  },
                  "taxation": {
                      "title": "Taxation",
                      "type": "array",
                      "minItems": 0,
                      "uniqueItems": true,
                      "items": {
                          "title": "Tax",
                          "type": "object",
                          "properties": {
                              "type": {
                                  "title": "Type",
                                  "type": "string",
                                  "enum": [
                                      "fixed",
                                      "percent"
                                  ],
                                  "description": "Nature de la taxe appliquée : un pourcentage ou bien une valeur fixe."
                              },
                              "value": {
                                  "title": "Value",
                                  "type": "number",
                                  "minimum": 0.01,
                                  "description": "Valeur de la taxe appliquée (Taux ou valeur fixe)."
                              },
                              "tax_code": {
                                  "title": "Tax code",
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 16,
                                  "description": "Code de la taxe telle qu'il est indiqué dans le cahier des charges."
                              }
                          },
                          "additionalProperties": false,
                          "required": [
                              "type",
                              "value",
                              "tax_code"
                          ]
                      }
                  },
                  "quantity": {
                      "title": "Quantity",
                      "type": "integer",
                      "minimum": 1,
                      "description": "Quantité achetée par produit."
                  },
                  "discount_per_unit": {
                      "title": "Discount",
                      "type": "object",
                      "properties": {
                          "percent": {
                              "title": "Percent",
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100,
                              "description": "Taux de la remise additionnelle globale."
                          },
                          "value": {
                              "title": "Value",
                              "type": "integer",
                              "minimum": 0,
                              "description": "Montant de la remise additionnelle globale. En millimes, sans séparateurs et sans point décimal."
                          }
                      },
                      "additionalProperties": false,
                      "description": "Remise additionnelle globale appliquée sur tout le ticket.",
                      "required": [
                          "percent",
                          "value"
                      ]
                  }
              },
              "additionalProperties": false,
              "required": [
                  "product",
                  "taxation",
                  "quantity",
                  "discount_per_unit"
              ]
          },
          "minItems": 1,
          "uniqueItems": false
      },
      "tax_summary": {
          "title": "Tax summary",
          "type": "array",
          "uniqueItems": true,
          "minItems": 0,
          "items": {
              "title": "Tax aggregate",
              "type": "object",
              "properties": {
                  "tax_code": {
                      "title": "Tax code",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16,
                      "description": "Code de la taxe telle qu'il est indiqué dans le cahier des charges."
                  },
                  "total_amount": {
                      "title": "Total amount",
                      "type": "integer",
                      "minimum": 0,
                      "description": "Montant total de la taxe."
                  }
              },
              "additionalProperties": false,
              "required": [
                  "tax_code",
                  "total_amount"
              ]
          }
      },
      "general_discount": {
          "title": "Discount",
          "type": "object",
          "properties": {
              "percent": {
                  "title": "Percent",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Taux de la remise additionnelle globale."
              },
              "value": {
                  "title": "Value",
                  "type": "integer",
                  "minimum": 0,
                  "description": "Montant de la remise additionnelle globale. En millimes, sans séparateurs et sans point décimal."
              }
          },
          "additionalProperties": false,
          "description": "Remise additionnelle globale appliquée sur tout le ticket.",
          "required": [
              "percent",
              "value"
          ]
      },
      "additional_tax": {
          "title": "Tax",
          "type": "object",
          "properties": {
              "type": {
                  "title": "Type",
                  "type": "string",
                  "enum": [
                      "fixed",
                      "percent"
                  ],
                  "description": "Nature de la taxe appliquée : un pourcentage ou bien une valeur fixe."
              },
              "value": {
                  "title": "Value",
                  "type": "number",
                  "minimum": 0.00,
                  "description": "Valeur de la taxe appliquée (Taux ou valeur fixe)."
              },
              "tax_code": {
                  "title": "Tax code",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "description": "Code de la taxe telle qu'il est indiqué dans le cahier des charges."
              }
          },
          "additionalProperties": false,
          "required": [
              "type",
              "value",
              "tax_code"
          ]
      },
      "payment_details": {
          "title": "Payment details",
          "type": "object",
          "properties": {
              "collection_details": {
                  "title": "Collection details",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                      "title": "Payment collection",
                      "type": "object",
                      "properties": {
                          "method": {
                              "title": "Method",
                              "type": "string",
                              "enum": [
                                  "cash",
                                  "check",
                                  "bank_card",
                                  "restaurant_ticket",
                                  "mobile_payment",
                                  "contre_bon",
                                  "wire_transfer"
                              ],
                              "description": "Mode de payement : en espèces (cash), chèque (check), carte bancaire (bank_card), ticket resto. (restaurant_ticket), App. mobile (mobile_payment), contre bon (contre_bon), virement (wire_transfer)."
                          },
                          "amount": {
                              "title": "Amount",
                              "type": "integer",
                              "minimum": 1,
                              "description": "Montant servi par le client."
                          }
                      },
                      "additionalProperties": false,
                      "required": [
                          "method",
                          "amount"
                      ]
                  }
              },
              "returned_change": {
                  "title": "Returned change",
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 0,
                  "items": {
                      "title": "Returned change",
                      "type": "object",
                      "properties": {
                          "method": {
                              "title": "Method",
                              "type": "string",
                              "enum": [
                                  "cash",
                                  "contre_bon"
                              ],
                              "description": "Montant rendu en espèce (cash) ou par contre bon (contre_bon)."
                          },
                          "amount": {
                              "title": "Amount",
                              "type": "integer",
                              "minimum": 1,
                              "description": "Valeur du montant rendu."
                          }
                      },
                      "additionalProperties": false,
                      "required": [
                          "method",
                          "amount"
                      ]
                  }
              }
          },
          "additionalProperties": false,
          "required": [
              "collection_details",
              "returned_change"
          ]
      },
      "sale_summary": {
          "title": "Sale summary",
          "type": "object",
          "properties": {
              "total_excl_tax": {
                  "title": "Total excluding tax",
                  "type": "integer",
                  "minimum": 0,
                  "description": "Montant total du ticket en Hors Taxes (HT) après remises appliquées sur les produits."
              },
              "total_incl_tax": {
                  "title": "Total including tax",
                  "type": "integer",
                  "minimum": 0,
                  "description": "Montant total du ticket Toutes Taxes Comprises (TTC)."
              },
              "total_tax": {
                  "title": "Total tax",
                  "type": "integer",
                  "minimum": 0,
                  "description": "Montant total des taxes appliquées."
              }
          },
          "additionalProperties": false,
          "required": [
              "total_excl_tax",
              "total_incl_tax",
              "total_tax"
          ]
      },
      "delivery_details": {
          "title": "Delivery Details",
          "type": "object",
          "properties": {
              "type": {
                  "title": "Type",
                  "type": "string",
                  "enum": [
                      "SELF_PICKUP",
                      "DELIVERY"
                  ],
                  "description": "Mode de livraison:\n -SELF_PICKUP: Livraison Directe\n -DELIVERY: Livraison par société de livraison."
              }
          },
          "additionalProperties": true,
          "if": {
              "properties": {
                  "type": {
                      "title": "Type",
                      "type": "string",
                      "const": "DELIVERY"
                  }
              }
          },
          "then": {
              "properties": {
                  "carrier_id": {
                      "title": "Carrier ID",
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 8,
                      "pattern": "^\\d{7}[A-Z]$",
                      "description": "Matricule fiscal de la société de livraison.",
                      "format": "regex"
                  }
              },
              "required": [
                  "carrier_id"
              ]
          }
      }
  },
  "additionalProperties": false,
  "required": [
      "data_type",
      "version",
      "transaction",
      "merchant_identity",
      "customer_identity",
      "sale_details",
      "tax_summary",
      "general_discount",
      "additional_tax",
      "payment_details",
      "sale_summary",
      "delivery_details"
  ]
}
